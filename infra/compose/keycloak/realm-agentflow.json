{
  "realm": "agentflow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": false,
  "roles": {
    "realm": [
      {
        "name": "workflow:read",
        "description": "Read a workflow definition (list / get).",
        "composite": false
      },
      {
        "name": "workflow:write",
        "description": "Create or edit a workflow definition draft.",
        "composite": false
      },
      {
        "name": "workflow:activate",
        "description": "Activate an immutable workflow version.",
        "composite": false
      },
      {
        "name": "document:read",
        "description": "Read a document or search the knowledge base (citations only from real chunks).",
        "composite": false
      },
      {
        "name": "document:write",
        "description": "Upload a document to the knowledge base.",
        "composite": false
      },
      {
        "name": "run:execute",
        "description": "Create a run, read run status/steps/result and cancel it.",
        "composite": false
      },
      {
        "name": "run:approve",
        "description": "Approve or reject a human-approval step.",
        "composite": false
      },
      {
        "name": "ops:dlq",
        "description": "Inspect and reprocess dead-letter queue messages.",
        "composite": false
      }
    ]
  },
  "clientScopes": [
    {
      "name": "agentflow",
      "displayName": "AgentFlow default claims",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "username",
            "claim.name": "preferred_username",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-property-mapper",
          "config": {
            "user.attribute": "email",
            "claim.name": "email",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-full-name-mapper",
          "config": {
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "claim.name": "tenant_id",
            "jsonType.label": "String",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true",
            "introspection.token.claim": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "realm-access-roles",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        },
        {
          "name": "fixed-audience",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ],
      "fullScopeAllowed": false,
      "roles": [
        {
          "name": "workflow:read",
          "composite": false
        },
        {
          "name": "workflow:write",
          "composite": false
        },
        {
          "name": "workflow:activate",
          "composite": false
        },
        {
          "name": "document:read",
          "composite": false
        },
        {
          "name": "document:write",
          "composite": false
        },
        {
          "name": "run:execute",
          "composite": false
        },
        {
          "name": "run:approve",
          "composite": false
        },
        {
          "name": "ops:dlq",
          "composite": false
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agentflow-web",
      "enabled": true,
      "publicClient": true,
      "description": "User-facing browser client (S04-02). Public SPA: Authorization Code flow + PKCE, no client secret. The resource server / audience is agentflow-api.",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "defaultClientScopes": [
        "agentflow"
      ],
      "protocol": "openid-connect"
    },
    {
      "clientId": "agentflow-service",
      "enabled": true,
      "publicClient": false,
      "description": "Machine-to-machine client (S04-02). Confidential, Client Credentials grant (service accounts) only. Secret is injected from the container environment (${AGENTFLOW_SERVICE_CLIENT_SECRET}), never committed to Git.",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AGENTFLOW_SERVICE_CLIENT_SECRET}",
      "defaultClientScopes": [
        "agentflow"
      ],
      "webOrigins": [],
      "protocol": "openid-connect"
    },
    {
      "clientId": "agentflow-api",
      "enabled": true,
      "publicClient": true,
      "description": "Resource server / OIDC audience (S04-02). Validates incoming user tokens; aud = agentflow-api (see .env.example). It does not issue tokens, so it needs no login flow, no service accounts and no client secret.",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect"
    }
  ],
  "components": {
    "org.keycloak.userprofile.UserProfileProvider": [
      {
        "providerId": "declarative-user-profile",
        "subComponents": {},
        "config": {
          "kc.user.profile.config": [
            "{\"attributes\":[{\"name\":\"username\",\"displayName\":\"${username}\",\"validations\":{\"length\":{\"min\":3,\"max\":255},\"username-prohibited-characters\":{},\"up-username-not-idn-homograph\":{}},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"email\",\"displayName\":\"${email}\",\"validations\":{\"email\":{},\"length\":{\"max\":255}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"firstName\",\"displayName\":\"${firstName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false},{\"name\":\"lastName\",\"displayName\":\"${lastName}\",\"validations\":{\"length\":{\"max\":255},\"person-name-prohibited-characters\":{}},\"required\":{\"roles\":[\"user\"]},\"permissions\":{\"view\":[\"admin\",\"user\"],\"edit\":[\"admin\",\"user\"]},\"multivalued\":false}],\"groups\":[{\"name\":\"user-metadata\",\"displayHeader\":\"User metadata\",\"displayDescription\":\"Attributes, which refer to user metadata\"}],\"unmanagedAttributePolicy\":\"ADMIN_EDIT\"}"
          ]
        }
      }
    ]
  }
}
