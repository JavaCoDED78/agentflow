{
  "realm": "agentflow",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "accessTokenLifespan": 300,
  "revokeRefreshToken": false,
  "roles": {
    "realm": [
      { "name": "workflow:read", "composite": false },
      { "name": "workflow:write", "composite": false },
      { "name": "workflow:approve", "composite": false },
      { "name": "knowledge:read", "composite": false },
      { "name": "tenant:admin", "composite": false }
    ]
  },
  "clientScopes": [
    {
      "name": "agentflow",
      "displayName": "AgentFlow default claims",
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "preferred-username",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-protocol-mapper",
          "config": {
            "user.model.property": "username",
            "oidc.claim.name": "preferred_username",
            "full.body.value": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "email",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-protocol-mapper",
          "config": {
            "user.model.property": "email",
            "oidc.claim.name": "email",
            "full.body.value": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "full-name",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-protocol-mapper",
          "config": {
            "user.model.property": "fullName",
            "oidc.claim.name": "name",
            "full.body.value": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "tenant-id",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "tenant_id",
            "oidc.claim.name": "tenant_id",
            "full.body.value": "true",
            "multivalued": "false"
          }
        },
        {
          "name": "fixed-audience",
          "protocol": "openid-connect",
          "consentRequired": false,
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "agentflow-api",
            "access.token.claim": "true",
            "id.token.claim": "false"
          }
        }
      ]
    }
  ],
  "clients": [
    {
      "clientId": "agentflow-web",
      "enabled": true,
      "publicClient": true,
      "description": "User-facing browser client (S04-02). Public SPA: Authorization Code flow + PKCE, no client secret. The resource server / audience is agentflow-api.",
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://localhost:3000/*"],
      "webOrigins": ["http://localhost:3000"],
      "defaultClientScopes": ["agentflow"],
      "protocol": "openid-connect"
    },
    {
      "clientId": "agentflow-service",
      "enabled": true,
      "publicClient": false,
      "description": "Machine-to-machine client (S04-02). Confidential, Client Credentials grant (service accounts) only. Secret is injected from the container environment (${AGENTFLOW_SERVICE_CLIENT_SECRET}), never committed to Git.",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "${AGENTFLOW_SERVICE_CLIENT_SECRET}",
      "defaultClientScopes": ["agentflow"],
      "webOrigins": [],
      "protocol": "openid-connect"
    },
    {
      "clientId": "agentflow-api",
      "enabled": true,
      "publicClient": true,
      "description": "Resource server / OIDC audience (S04-02). Validates incoming user tokens; aud = agentflow-api (see .env.example). It does not issue tokens, so it needs no login flow, no service accounts and no client secret.",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "defaultClientScopes": [],
      "redirectUris": [],
      "webOrigins": [],
      "protocol": "openid-connect"
    }
  ]
}
