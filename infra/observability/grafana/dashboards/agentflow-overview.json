        "overrides": []
      },
      "options": {
        "legend": {"displayMode": "list", "placement": "bottom", "showLegend": true},
        "tooltip": {"mode": "multi", "sort": "none"}
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {"type": "prometheus", "uid": "agentflow-prometheus"},
          "expr": "otelcol_process_uptime{job=\"otel-collector\"}",
          "instant": false,
          "range": true,
          "legendFormat": "uptime"
