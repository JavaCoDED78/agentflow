{
  "uid": "agentflow-api-jvm-db",
  "title": "AgentFlow / API/JVM/DB (S13-14)",
  "description": "API/JVM/DB operational dashboard (S13-14): HTTP request rate and 5xx error rate, average and p95 latency, JVM heap/GC/CPU/threads, and HikariCP DB pool saturation \u2014 Actuator-native metrics over the dedicated Prometheus (uid agentflow-prometheus). Units labelled on every panel. No identifiers: all series are bounded by the Actuator defaults. Provisioned from Git; UI edits are refused.",
  "tags": [
    "agentflow",
    "s13-14"
  ],
  "timezone": "browser",
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "links": [],
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request rate (requests/s)",
      "description": "All HTTP requests the API serves, summed over the bounded uri/method/status/outcome tags. Bounded by route template \u2014 no raw path with ids.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agentflow-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 12,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "none",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agentflow-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count[1m]))",
          "instant": false,
          "range": true,
          "legendFormat": "requests/s"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "5xx error rate (requests/s)",
      "description": "Server errors only (status 5xx). 4xx client errors are excluded \u2014 they are the client's fault, not the API's.",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agentflow-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 20,
            "showPoints": "never",
            "line": {
              "color": "red"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "none",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agentflow-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
          "instant": false,
          "range": true,
          "legendFormat": "5xx req/s"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "p95 latency (seconds)",
      "description": "95th-percentile HTTP request latency (histogram_quantile over the S13-14 percentiles-histogram buckets, 5m window).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agentflow-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "none",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agentflow-prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket[5m])))",
          "instant": false,
          "range": true,
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Average latency (seconds)",
      "description": "Mean HTTP request latency (sum of request duration / count, 5m window).",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "agentflow-prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "none",
          "showLegend": false
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "agentflow-prometheus"
          },
          "expr": "sum(rate(http_server_requests_seconds_sum[5m])) / sum(rate(http_server_requests_seconds_count[5m]))",
          "instant": false,
          "range": true,
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
