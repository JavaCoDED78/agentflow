                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "404" : {
            "description" : "no run matches the (tenant_id, runId) the API was asked to read",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "503" : {
            "description" : "no database connection is configured",
            "content" : {
