        "operationId" : "getRun",
        "parameters" : [ {
          "name" : "runId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "the run status snapshot (RunDto)",
            "content" : {
