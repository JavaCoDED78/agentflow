    "/api/v1/runs/{runId}/attempts" : {
      "get" : {
        "tags" : [ "workflow-run-controller" ],
        "summary" : "Read a run's attempt history",
        "description" : "Returns the run's per-attempt execution history (AttemptRecord): attempt number, worker instance, outcome, start/finish instants, durationSeconds and the safe error category (ErrorClass token + redacted reason), never the secret payload. Tenant-scoped (invariant 1): a run of another tenant is indistinguishable from a missing run and is a 404, never a leak.",
        "operationId" : "getAttemptHistory",
        "parameters" : [ {
          "name" : "runId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "the attempt history (AttemptRecord[])",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AttemptRecord"
                  }
                }
              }
            }
          },
          "404" : {
            "description" : "no run matches the (tenant_id, runId) the API was asked to read",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AttemptRecord"
                  }
                }
              }
            }
          },
          "503" : {
            "description" : "no database connection is configured",
            "content" : {
              "*/*" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/AttemptRecord"
                  }
                }
              }
            }
          }
        }
      }
