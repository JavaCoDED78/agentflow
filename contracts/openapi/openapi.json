    "/api/v1/runs" : {
      "post" : {
        "tags" : [ "workflow-run-controller" ],
        "summary" : "Start a workflow run (idempotent under Idempotency-Key)",
        "description" : "Starts a run pinned to the tenant's active version and returns it in status QUEUED (202 Accepted — the workflow is starting, not complete, invariant 11). Idempotent under Idempotency-Key (S06-06): a repeat with the same payload returns the original run; a repeat with a different payload under the same key is a 409 conflict; neither is a silent overwrite.",
        "operationId" : "create_1",
        "parameters" : [ {
          "name" : "Idempotency-Key",
          "in" : "header",
          "description" : "A client-chosen idempotency key. A repeat with the same payload under this key returns the original run (S06-06); a different payload under the same key is a 409 conflict. Omit for an unkeyed create.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "name" : "traceparent",
          "in" : "header",
          "description" : "An optional W3C Trace-Context trace-parent header (e.g. \"00-<traceId>-<spanId>-<flags>\"). It is threaded verbatim into the run request event's correlation headers so the trace survives across Kafka (S06-12); it is a trace label only and never an authorization input (invariant 1). Omit for an untraced create.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "type" : "string"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "202" : {
            "description" : "the run started, or the original run replayed when the key matches the payload",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "400" : {
            "description" : "the body is not the workflowId-carrying JSON the contract expects",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "409" : {
            "description" : "a reused Idempotency-Key carries a different request payload",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "429" : {
            "description" : "the (tenant, principal) exceeded the per-group API rate limit",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "503" : {
            "description" : "no database connection is configured",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}/cancel" : {
      "post" : {
        "tags" : [ "workflow-run-controller" ],
        "summary" : "Request cancellation of a run",
        "description" : "Moves the run to the cancellation-in-flight state CANCEL_REQUESTED; the worker drains it cooperatively (S07-12). Idempotent and one-way: a no-op on an already-terminal or already-cancelling run (never erases a completed result). Tenant-scoped (invariant 1): a run of another tenant is a 404.",
        "operationId" : "cancelRun",
        "parameters" : [ {
          "name" : "runId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "202" : {
            "description" : "cancellation requested; the run status snapshot",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "404" : {
            "description" : "no run matches the (tenant_id, runId) the API was asked to cancel",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          },
          "503" : {
            "description" : "no database connection is configured",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/RunDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/runs/{runId}/approvals/{approvalId}" : {
      "post" : {
        "tags" : [ "approval-controller" ],
        "summary" : "Decide a human-approval request: approve resumes the run, reject fails it (idempotent)",
        "description" : "Records the human decision on a PENDING approval and its audit row in one transaction (S11-04/S11-05, ADR-018). approve resumes the run (WAITING_FOR_APPROVAL -> RUNNING, workflow.run.resumed.v1 through the outbox) — after re-validating that the stored payload fingerprint still binds to the run's pinned graph (S11-06), so an approved argument set can never execute a different one; reject refuses the side effect (run and gated step -> FAILED, workflow.run.rejected.v1) — the gated side effect never executes. Idempotent: a repeat — with or without the Idempotency-Key — replays the recorded decision instead of writing a second one; a reused key with a different payload is a 409. Requires the run:approve authority (S04-08); tenant-scoped so another tenant's approval is a 404, never a leak.",
        "operationId" : "decideApproval",
        "parameters" : [ {
          "name" : "runId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "approvalId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "name" : "Idempotency-Key",
          "in" : "header",
          "description" : "A client-chosen idempotency key. A repeat with the same payload under this key replays the recorded decision (S11-04); a different payload under the same key is a 409 conflict. Omit for an unkeyed decision — the state-based replay still answers a repeat.",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "requestBody" : {
          "description" : "The decision body — {\"decision\":\"approve\",\"comment\":…}. Consumed as the raw bytes so the idempotency fingerprint is canonical (wire-format independent).",
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/ApprovalDecisionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "the decision snapshot (original or replayed)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDecisionDto"
                }
              }
            }
          },
          "400" : {
            "description" : "the body is not the decision JSON, the decision is neither 'approve' nor 'reject', or the key is not a UUID",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDecisionDto"
                }
              }
            }
          },
          "404" : {
            "description" : "no approval matches (tenant_id, run_id, approvalId)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDecisionDto"
                }
              }
            }
          },
          "409" : {
            "description" : "already decided otherwise, expired, the step moved on, the stored payload fingerprint no longer binds to the run's pinned payload (S11-06), or a reused key carries a different payload",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDecisionDto"
                }
              }
            }
          },
          "503" : {
            "description" : "no database connection is configured",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ApprovalDecisionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/ops/dlq/{dlqId}/redrive" : {
      "post" : {
        "tags" : [ "dlq-inspection-controller" ],
        "description" : "Operator-only, controlled redrive (S12-12): re-publish the failed envelope under a fresh id, guarded by the inbox source of truth, recorded idempotently and audited. Requires {@code ops:dlq}; an ordinary tenant principal is denied (403).",
        "operationId" : "redrive",
        "parameters" : [ {
          "name" : "dlqId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/DlqRedriveRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "the redrive result (re-published envelope id, or the existing redrive on a replay)",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DlqRedriveResult"
                }
              }
            }
          },
          "400" : {
            "description" : "a blank operator reason",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DlqRedriveResult"
                }
              }
            }
          },
          "403" : {
            "description" : "caller lacks the ops:dlq permission",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DlqRedriveResult"
                }
              }
            }
          },
          "404" : {
            "description" : "no DLQ message / original outbox envelope with that id",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DlqRedriveResult"
                }
              }
            }
          },
          "409" : {
            "description" : "the message is already processed (terminal) or in-flight — redrive refused, the business change must not be duplicated",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DlqRedriveResult"
                }
              }
            }
          },
          "503" : {
            "description" : "no database connection is configured",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/DlqRedriveResult"
                }
              }
            }
          }
        }
      }
    },
