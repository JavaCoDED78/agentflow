{
  "openapi" : "3.1.0",
  "info" : {
    "title" : "AgentFlow API",
    "description" : "REST API for the AgentFlow durable workflow platform. Endpoints are served under {@code /api/v1}; the tenant is taken only from the verified security context, never from the request body.",
    "version" : "v1"
  },
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/api/v1/workflows" : {
      "get" : {
        "tags" : [ "workflow-definition-controller" ],
        "operationId" : "listDefinitions",
        "parameters" : [ {
          "name" : "page",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0
          }
        }, {
          "name" : "size",
          "in" : "query",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 20
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkflowDefinitionPageDto"
                }
              }
            }
          }
        }
      },
      "post" : {
        "tags" : [ "workflow-definition-controller" ],
        "operationId" : "create",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateWorkflowDefinitionRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkflowDefinitionDto"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/workflows/{workflowId}" : {
      "get" : {
        "tags" : [ "workflow-definition-controller" ],
        "operationId" : "getDefinition",
        "parameters" : [ {
          "name" : "workflowId",
          "in" : "path",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "description" : "OK",
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/WorkflowDefinitionDto"
                }
              }
            }
          }
        }
      }
    }
  },
  "components" : {
    "schemas" : {
      "CreateWorkflowDefinitionRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "minLength" : 1
          },
          "description" : {
            "type" : "string"
          }
        },
        "required" : [ "name" ]
      },
      "WorkflowDefinitionDto" : {
        "type" : "object",
        "properties" : {
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "tenantId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : "string"
          },
          "description" : {
            "type" : "string"
          },
          "status" : {
            "type" : "string"
          },
          "version" : {
            "type" : "integer",
            "format" : "int32"
          },
          "createdBy" : {
            "type" : "string"
          },
          "createdAt" : {
            "type" : "string",
            "format" : "date-time"
          }
        }
      },
      "WorkflowDefinitionPageDto" : {
        "type" : "object",
        "properties" : {
          "items" : {
            "type" : "array",
            "items" : {
              "$ref" : "#/components/schemas/WorkflowDefinitionDto"
            }
          },
          "page" : {
            "type" : "integer",
            "format" : "int32"
          },
          "size" : {
            "type" : "integer",
            "format" : "int32"
          },
          "totalElements" : {
            "type" : "integer",
            "format" : "int64"
          },
          "totalPages" : {
            "type" : "integer",
            "format" : "int32"
          },
          "hasNext" : {
            "type" : "boolean"
          },
          "hasPrevious" : {
            "type" : "boolean"
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "type" : "http",
        "description" : "OIDC access token from Keycloak, sent as {@code Authorization: Bearer <token>} (issuer and audience established by the OIDC resource server in S04).",
        "scheme" : "bearer",
        "bearerFormat" : "JWT"
      }
    }
  }
}