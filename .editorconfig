# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{md,yaml,yml,json,properties,tf}]
indent_size = 2

[*.md]
# Keep markdown tables readable; do not strip trailing spaces inside tables.
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
