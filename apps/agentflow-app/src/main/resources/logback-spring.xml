<?xml version="1.0" encoding="UTF-8"?>
<!--
  Logging configuration for the AgentFlow artifact (S01-19).

  Logs are structured JSON on stdout (consumed by the OpenTelemetry Collector /
  Loki). The structure lives in
  com.example.agentflow.observability.StructuredJsonLogstashEncoder: severity,
  @timestamp, message, logger_name, thread_name, the whitelisted MDC keys
  (service, environment, traceId, spanId, correlationId) and, when present, the
  exception — masked before serialization.

  Named logback-SPRING.xml (not logback.xml) so Spring Boot's <springProperty>
  and <profile> elements are available. This file is parsed before the Spring
  context exists: service/environment are seeded into the MDC by the
  LoggingContextProperties Spring bean (see package com.example.agentflow.observability),
  and the encoder writes the current thread's MDC by default.
-->
<configuration>

  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <!-- S13-09: the encoder class is the ONE place the JSON log field contract
         lives (@timestamp, severity, message, logger_name, thread_name, the
         whitelisted MDC keys service/environment/traceId/spanId/correlationId,
         plus the exception/stack trace when present). Do not configure ad-hoc
         encoders per module; change the encoder here. -->
    <encoder class="com.example.agentflow.observability.StructuredJsonLogstashEncoder">
      <!-- Masking stays on the wire path: the security-sensitive values are
           masked before serialization, so a canary key, a secret-like header
           or a credential-shaped message never reaches stdout / Loki. -->
      <decorator class="net.logstash.logback.mask.MaskingJsonGeneratorDecorator">
        <defaultMask>***</defaultMask>
        <valueMasker class="com.example.agentflow.observability.SecretRedactingValueMasker"/>
      </decorator>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="STDOUT"/>
  </root>

</configuration>
