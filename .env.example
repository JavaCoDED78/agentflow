# Local environment template for AgentFlow (S01-11).
#
# COPY THIS FILE to `.env` for local development and fill in the real values.
# NEVER commit the real `.env`: it is ignored by `.gitignore` and must never land
# in Git, Docker build args, logs, metrics or traces. This file only contains
# placeholders (CHANGEME) and non-secret localhost defaults.
#
# Spring Boot reads these as environment variables / system properties. The app
# uses typed @ConfigurationProperties with validation; a missing required value
# fails startup explicitly (see apps/agentflow-app/AGENTS.md).

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
spring.application.name=agentflow-app
server.port=8080

# ---------------------------------------------------------------------------
# PostgreSQL — source of truth (S01-12). Values are placeholders.
# ---------------------------------------------------------------------------
spring.datasource.url=jdbc:postgresql://localhost:5432/agentflow
spring.datasource.username=agentflow
spring.datasource.password=CHANGEME
spring.datasource.driver-class-name=org.postgresql.Driver

# ---------------------------------------------------------------------------
# Redis — cache / rate-limit / short-lived coordination only (S01-13).
# ---------------------------------------------------------------------------
spring.redis.host=localhost
spring.redis.port=6379
spring.redis.password=CHANGEME

# ---------------------------------------------------------------------------
# Kafka — durable event transport (S01-14).
# ---------------------------------------------------------------------------
spring.kafka.bootstrap-servers=localhost:9092

# The KRaft broker in infra/compose needs a one-time cluster id to format its
# Raft log on first start. Generate it once and export it before bringing the
# broker up, e.g. add the line to your local `.env` (never committed):
#
#   KAFKA_CLUSTER_ID=<output of: /opt/kafka/bin/kafka-storage.sh random-uuid>
#   # once the image is pulled, or:
#   docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid
# The compose `kafka` service fails fast (KAFKA_CLUSTER_ID is required) until
# it is set.

# ---------------------------------------------------------------------------
# Object storage (Garage, S3-compatible) — large document payloads &
# artifacts (S10-02). The local `core` stack uses Garage (free, open
# source, AGPL-3.0); the S3 API is on :3900 of the compose `garage`
# service. The bucket is PRIVATE: objects are read and written only
# through the app, never via a public or anonymous URL (the S10-02
# acceptance). The object key is generated server-side from the
# server-issued identifiers by
# com.example.agentflow.knowledgebase.domain.DocumentObjectKey — never
# from the client filename, and always namespaced by tenant.
#
# The endpoint / bucket / region are bound from the git-ignored `.env` to
# the typed `AgentFlowProperties.Storage` group (agentflow.storage.*) and
# MUST match the Garage bucket set in infra/compose (bucket: agentflow).
# The S3 credentials come from the environment only (invariant 8): never
# from configuration or source. They are consumed by the S3 client built
# in S10-03.
# ---------------------------------------------------------------------------
AGENTFLOW_OBJECT_STORAGE_ENDPOINT=http://localhost:3900
AGENTFLOW_OBJECT_STORAGE_ACCESS_KEY=CHANGEME
AGENTFLOW_OBJECT_STORAGE_SECRET_KEY=CHANGEME
AGENTFLOW_OBJECT_STORAGE_BUCKET=agentflow
AGENTFLOW_OBJECT_STORAGE_REGION=garage

# ---------------------------------------------------------------------------
# Keycloak — OIDC identity provider (S01-15).
# ---------------------------------------------------------------------------
cloak.issuer=http://localhost:8083/realms/agentflow
cloak.client-id=agentflow-api
cloak.client-secret=CHANGEME
cloak.audience=agentflow-api

# ---------------------------------------------------------------------------
# AI provider — Spring ChatModel (S09). No key here; set in a real secret store.
# ---------------------------------------------------------------------------
ai.provider=local            # local | openai | ... ; keep 'local' (or unset) for core app
ai.chat.model=CHANGEME
ai.api.key=CHANGEME

# ---------------------------------------------------------------------------
# OpenTelemetry — OTLP export (observability profile only).
# ---------------------------------------------------------------------------
otel.exporter.otlp.endpoint=http://localhost:4317
otel.service.name=agentflow-app

# ---------------------------------------------------------------------------
# Notes
# ---------------------------------------------------------------------------
# - Local dev credentials live here (`.env`, untracked) or as Docker Compose env.
# - `test`-only profiles (mock auth, fake AI provider) must never reach the
#   `kubernetes` / production profile.
# - Rotate any real secret out of this machine and into Kubernetes Secret / an
#   external secret manager before deployment.
